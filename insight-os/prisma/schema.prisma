// ─────────────────────────────────────────────────────────────
// Insight-OS — Prisma Schema
// Database: Neon PostgreSQL (serverless)
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Sites ────────────────────────────────────────────────────
model Site {
  id        String   @id @default(cuid())
  domain    String
  ownerId   String?  // References NextAuth user id
  createdAt DateTime @default(now()) @map("created_at")

  events  Event[]
  funnels Funnel[]

  @@map("sites")
}

// ─── Events (append-only, never updated) ──────────────────────
model Event {
  id          BigInt   @id @default(autoincrement())
  siteId      String   @map("site_id")
  site        Site     @relation(fields: [siteId], references: [id])
  type        String   // 'pageview' | 'click' | 'custom'
  url         String?
  referrer    String?
  country     String?  // 2-letter code from Geo-IP
  xPct        Float?   @map("x_pct")   // click X as % of viewport
  yPct        Float?   @map("y_pct")   // click Y as % of viewport
  sessionHash String?  @map("session_hash")
  uaRaw       String?  @map("ua_raw")
  isBot       Boolean  @default(false)  @map("is_bot")
  isBotHoneypot Boolean @default(false) @map("is_bot_honeypot")
  ts          DateTime @default(now())

  @@index([siteId, ts])
  @@index([sessionHash])
  @@index([siteId, url])
  @@map("events")
}

// ─── Hourly Stats (pre-aggregated — dashboard reads ONLY this) ─
model HourlyStat {
  siteId         String   @map("site_id")
  hour           DateTime
  pageviews      Int      @default(0)
  clicks         Int      @default(0)
  uniqueSessions Int      @default(0) @map("unique_sessions")
  topPages       Json     @default("[]") @map("top_pages")
  topReferrers   Json     @default("[]") @map("top_referrers")
  topCountries   Json     @default("[]") @map("top_countries")

  @@id([siteId, hour])
  @@map("hourly_stats")
}

// ─── Funnels ──────────────────────────────────────────────────
model Funnel {
  id          String   @id @default(uuid())
  siteId      String   @map("site_id")
  site        Site     @relation(fields: [siteId], references: [id])
  name        String
  steps       Json     // Array of URL paths e.g. ["/", "/pricing", "/checkout"]
  windowHours Int      @default(24) @map("window_hours")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("funnels")
}
